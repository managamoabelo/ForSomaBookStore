@model ForSomaBookStore.Models.WantedAd

@{
    ViewData["Title"] = "Post a Wanted Ad";
}

<h1>Post a Wanted Ad</h1>
<p class="text-muted">Let other students know which textbook you're looking for.</p>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Book / Title</label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Calculus 1 Textbook" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"
                          placeholder="Edition, course code, condition you're after, budget..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Post Ad</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
