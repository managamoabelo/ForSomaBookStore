@model IEnumerable<ForSomaBookStore.Models.WantedAd>
@using System.Security.Claims

@{
    ViewData["Title"] = "Wanted Ads";

    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var isAdmin = User.IsInRole("Admin");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0">Wanted Ads</h1>
        <p class="text-muted mb-0">Books students are looking for.</p>
    </div>
    <a asp-action="Create" class="btn btn-forsoma">
        <i class="fa-solid fa-plus"></i> Post a Wanted Ad
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No wanted ads have been posted yet.
    </div>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            var isOwner = item.UserId == currentUserId;

            <div class="col-md-6 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>

                        <p class="card-text">@item.Description</p>

                        <p class="small text-muted mb-2">
                            Posted by
                            <strong>@item.User?.FirstName @item.User?.LastName</strong>
                            on @item.DatePosted.ToString("dd MMM yyyy")
                        </p>

                        @if (isOwner || isAdmin)
                        {
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                  onsubmit="return confirm('Delete this wanted ad?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
