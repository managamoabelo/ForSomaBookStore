@model IEnumerable<Textbook>

@{
    ViewData["Title"] = "Home";
}

<div class="p-5 mb-4 bg-light rounded-3 shadow-sm">
    <div class="container-fluid py-4">

        <h1 class="display-5 fw-bold">
            Welcome to For Soma Book Store
        </h1>

        <p class="col-md-8 fs-4">
            Buy, sell and exchange textbooks with students safely.
        </p>

        <a asp-controller="Textbooks"
           asp-action="Index"
           class="btn btn-primary btn-lg">
            Browse Books
        </a>

    </div>

    <div class="row text-center mt-4">

        <div class="col">
            <h2>@ViewBag.Users</h2>
            <p class="text-muted">Students</p>
        </div>

        <div class="col">
            <h2>@ViewBag.Textbooks</h2>
            <p class="text-muted">Books</p>
        </div>

        <div class="col">
            <h2>@ViewBag.Transactions</h2>
            <p class="text-muted">Transactions</p>
        </div>

    </div>
</div>

<h2 class="mb-4">Latest Textbooks</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No textbooks have been listed yet.
    </div>
}
else
{
    <div class="row">
        @foreach (var book in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">

                    @if (!string.IsNullOrEmpty(book.ImageUrl))
                    {
                        <img src="@book.ImageUrl" class="card-img-top book-cover" alt="@book.Title" />
                    }
                    else
                    {
                        <div class="book-cover-placeholder">
                            <i class="fa-solid fa-book"></i>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title mb-1">@book.Title</h5>
                        <p class="text-muted mb-2">@book.Author</p>

                        <p class="fw-bold text-success mb-3">
                            R @book.Price.ToString("N2")
                        </p>

                        <a asp-controller="Textbooks"
                           asp-action="Details"
                           asp-route-id="@book.Id"
                           class="btn btn-primary mt-auto">
                            View Details
                        </a>

                    </div>

                </div>
            </div>
        }
    </div>
}
