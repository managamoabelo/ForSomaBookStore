@model IEnumerable<ForSomaBookStore.Models.Offer>

@{
    ViewData["Title"] = "Offers Received";
}

<h1>Offers Received</h1>
<p class="text-muted">Offers other students have made on your listings.</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You have not received any offers yet.
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Textbook</th>
                <th>Buyer</th>
                <th>Offer</th>
                <th>Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(item.Textbook?.Title ?? "Unknown Book")</td>

                    <td>
                        @if (item.Buyer != null)
                        {
                            @($"{item.Buyer.FirstName} {item.Buyer.LastName}")
                        }
                        else
                        {
                            <span class="text-muted">Unknown</span>
                        }
                    </td>

                    <td>R @item.OfferAmount.ToString("N2")</td>

                    <td>@item.OfferDate.ToString("dd MMM yyyy")</td>

                    <td>
                        @if (item.Status == Offer.OfferStatus.Accepted)
                        {
                            <span class="badge bg-success">Accepted</span>
                        }
                        else if (item.Status == Offer.OfferStatus.Rejected)
                        {
                            <span class="badge bg-danger">Rejected</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                    </td>

                    <td>
                        @if (item.Status == Offer.OfferStatus.Pending)
                        {
                            <form asp-action="Accept" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-success btn-sm">Accept</button>
                            </form>

                            <form asp-action="Reject" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
