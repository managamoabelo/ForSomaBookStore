@model IEnumerable<ForSomaBookStore.Models.Offer>

@{
    ViewData["Title"] = "Index";
}

<h1>Offers</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.OfferAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OfferDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                Textbook
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BuyerId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Buyer)
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.OfferAmount)
            </td>
            <td>
                @Html.DisplayFor(model => item.OfferDate)
            </td>
            <td>
                @if (item.Status == Offer.OfferStatus.Accepted)
                {
                    <span class="badge bg-success">Accepted</span>
                }
                else if (item.Status == Offer.OfferStatus.Rejected)
                {
                    <span class="badge bg-danger">Rejected</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Pending</span>
                }
            </td>
            <td>
                @(item.Textbook?.Title ?? "Unknown Book")
            </td>
            <td>
                @Html.DisplayFor(model => item.BuyerId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Buyer)
            </td>
            <td>
                @if(item.Status == Offer.OfferStatus.Pending)
                {
                    <form asp-action="Accept" asp-route-id="@item.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-success btn-sm"> Accept </button>
                    </form>

                    <a asp-action="Reject" asp-route-id="@item.Id" class="btn btn-danger btn-sm"> Reject </a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
