@model IEnumerable<ForSomaBookStore.Models.Review>

@{
    ViewData["Title"] = "Reviews";
}

<h1>Reviews</h1>
<p class="text-muted">
    Reviews are left after a transaction is completed. You can leave one from your
    <a asp-controller="Transactions" asp-action="Index">transactions</a>.
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No reviews have been left yet.
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Rating</th>
                <th>Reviewer</th>
                <th>Seller</th>
                <th>Comment</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @for (int i = 0; i < item.Rating; i++)
                        {
                            <i class="fa-solid fa-star text-warning"></i>
                        }
                    </td>
                    <td>@item.Reviewer?.FirstName @item.Reviewer?.LastName</td>
                    <td>@item.Reviewee?.FirstName @item.Reviewee?.LastName</td>
                    <td>@item.Comment</td>
                </tr>
            }
        </tbody>
    </table>
}
