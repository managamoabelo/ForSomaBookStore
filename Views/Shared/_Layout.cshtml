@using Microsoft.AspNetCore.Identity
@using ForSomaBookStore.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - For Soma Book Store</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        :root {
            --forsoma-blue: #1D4ED8;
            --forsoma-green: #16A34A;
            --forsoma-orange: #F97316;
        }

        body {
            background-color: #f8fafc;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-brand {
            font-weight: bold;
            color: white !important;
        }

        .navbar {
            background: linear-gradient(90deg, var(--forsoma-blue), var(--forsoma-green));
        }

        .btn-forsoma {
            background-color: var(--forsoma-orange);
            color: white;
        }

        .btn-forsoma:hover {
            background-color: #ea580c;
            color: white;
        }

        .footer {
            margin-top: auto;
            background-color: #0f172a;
            color: white;
            padding: 20px;
        }

        .search-box {
            width: 350px;
        }

        .nav-link {
            font-weight: 500;
        }

        .profile-badge {
            background-color: var(--forsoma-orange);
            color: white;
            padding: 5px 10px;
            border-radius: 20px;
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow">
            <div class="container">
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                    <i class="fa-solid fa-book"></i>
                    For Soma Book Store
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Textbooks" asp-action="Index">Browse Books</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="WantedAds" asp-action="Index">Wanted Ads</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Offers" asp-action="Index">Offers</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Reviews" asp-action="Index">Reviews</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Transactions" asp-action="Index">Transactions</a>
                        </li>
                    </ul>

                    <form asp-controller="Textbooks" asp-action="Index" method="get" class="d-flex me-3">
                        <input type="text" name="searchString" class="form-control search-box" placeholder="Search textbooks, authors, ISBN..." />
                        <button type="submit" class="btn btn-light ms-2">
                            <i class="fa fa-search"></i>
                        </button>
                    </form>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="dropdown me-3">
                            <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">Quick Actions</button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-controller="Textbooks" asp-action="Create">Sell Textbook</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="WantedAds" asp-action="Create">Post Wanted Ad</a>
                                </li>
                            </ul>
                        </div>

                        <ul class="navbar-nav">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">@User.Identity?.Name</a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Profile" asp-action="Index">My Profile</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Textbooks" asp-action="MyListings">My Listings</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Offers" asp-action="Index">My Offers</a>
                                    </li>
                                </ul>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                        <i class="fa-solid fa-user-shield"></i>
                                        Admin
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <form method="post" action="/Identity/Account/Logout">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-light ms-2">Logout</button>
                                </form>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" href="/Identity/Account/Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-forsoma ms-2" href="/Identity/Account/Register">Register</a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5>
                        <i class="fa-solid fa-book"></i>
                        For Soma Book Store
                        <small class="d-block fs-6">South African Student Marketplace</small>
                    </h5>
                    <p>Buy, Sell and Exchange textbooks safely with fellow students.</p>
                </div>

                <div class="col-md-4">
                    <h5>Quick Links</h5>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Textbooks" asp-action="Index" class="text-white">Browse Books</a></li>
                        <li><a asp-controller="WantedAds" asp-action="Index" class="text-white">Wanted Ads</a></li>
                        <li><a asp-controller="Offers" asp-action="Index" class="text-white">Offers</a></li>
                        <li><a asp-controller="Reviews" asp-action="Index" class="text-white">Reviews</a></li>
                    </ul>
                </div>

                <div class="col-md-4">
                    <h5>Safe Campus Trading</h5>
                    <p>Recommended meetup locations:</p>
                    <ul>
                        <li>Campus Library</li>
                        <li>Student Centre</li>
                        <li>Campus Reception</li>
                    </ul>
                </div>
            </div>

            <hr />

            <div class="text-center">
                © @DateTime.Now.Year For Soma Book Store | ASP.NET Core MVC | Built for Students
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
