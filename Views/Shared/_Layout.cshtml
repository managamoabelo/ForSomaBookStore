@using Microsoft.AspNetCore.Identity
@using ForSomaBookStore.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - For Soma Book Store</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

    <link rel="stylesheet" href="~/css/site.css" />

    <style>

            :root {
                --forsoma-blue: #1D4ED8;
                --forsoma-green: #16A34A;
                --forsoma-orange: #F97316;
            }

            body {
                background-color: #f8fafc;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .navbar-brand {
                font-weight: bold;
                color: white !important;
            }

            .navbar {
                background: linear-gradient(
                    90deg,
                    var(--forsoma-blue),
                    var(--forsoma-green));
            }

            .btn-forsoma {
                background-color: var(--forsoma-orange);
                color: white;
            }

            .btn-forsoma:hover {
                background-color: #ea580c;
                color: white;
            }

            .footer {
                margin-top: auto;
                background-color: #0f172a;
                color: white;
                padding: 20px;
            }

            .search-box {
                width: 350px;
            }

            .nav-link {
                font-weight: 500;
            }

            .profile-badge {
                background-color: var(--forsoma-orange);
                color: white;
                padding: 5px 10px;
                border-radius: 20px;
            }

    </style>
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark shadow">

            <div class="container">

                <a class="navbar-brand"
                   href="@Url.Action("Index", "Home")">

                    <i class="fa-solid fa-book"></i>
                    For Soma Book Store

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="navbarContent">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index", "Home")">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index", "Textbooks")">
                                Textbooks
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index", "WantedAds")">
                                Wanted Ads
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index", "Transactions")">
                                Transactions
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("About", "Home")">
                                About
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Contact", "Home")">
                                Contact
                            </a>
                        </li>

                    </ul>

                    <form action="@Url.Action("Index", "Textbooks")"
                          method="get"
                          class="d-flex me-3">

                        <input type="text"
                               name="searchString"
                               class="form-control search-box"
                               placeholder="Search books, ISBN, author..." />

                        <button type="submit"
                                class="btn btn-light ms-2">

                            <i class="fa fa-search"></i>

                        </button>

                    </form>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <ul class="navbar-nav">

                            <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index", "Dashboard")">

                                    <i class="fa-solid fa-chart-line"></i>
                                    Dashboard

                                </a>
                            </li>

                            <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index", "Profile")">

                                    <span class="profile-badge">
                                        @User.Identity?.Name
                                    </span>

                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       href="@Url.Action("Index", "Admin")">

                                        <i class="fa-solid fa-user-shield"></i>
                                        Admin

                                    </a>
                                </li>
                            }

                            <li class="nav-item">

                                <form method="post" action="/Identity/Account/Logout">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-outline-light ms-2">

                                        Logout

                                    </button>

                                </form>

                            </li>

                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav">

                            <li class="nav-item">

                                <a class="nav-link"
                                   href="/Identity/Account/Login">

                                    Login

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="btn btn-forsoma ms-2"
                                   href="/Identity/Account/Register">

                                    Register

                                </a>

                            </li>

                        </ul>
                    }

                </div>

            </div>

        </nav>

    </header>

    <div class="container mt-4">

        <main role="main">

            @RenderBody()

        </main>

    </div>

    <footer class="footer mt-5">

        <div class="container">

            <div class="row">

                <div class="col-md-4">

                    <h5>
                        <i class="fa-solid fa-book-open"></i>
                        For Soma Book Store
                    </h5>

                    <p>
                        Buy, Sell and Exchange textbooks safely
                        with fellow students.
                    </p>

                </div>

                <div class="col-md-4">

                    <h5>Quick Links</h5>

                    <ul class="list-unstyled">

                        <li>
                            <a href="@Url.Action("About", "Home")"
                               class="text-white">
                                About Us
                            </a>
                        </li>

                        <li>
                            <a href="@Url.Action("Contact", "Home")"
                               class="text-white">
                                Contact
                            </a>
                        </li>

                        <li>
                            <a href="@Url.Action("Index", "Textbooks")"
                               class="text-white">
                                Browse Books
                            </a>
                        </li>

                    </ul>

                </div>

                <div class="col-md-4">

                    <h5>Safe Campus Trading</h5>

                    <p>
                        Recommended meetup locations:
                    </p>

                    <ul>
                        <li>Campus Library</li>
                        <li>Student Centre</li>
                        <li>Campus Reception</li>
                    </ul>

                </div>

            </div>

            <hr />

            <div class="text-center">

                © @DateTime.Now.Year
                For Soma Book Store |
                ASP.NET Core MVC |
                Built for Students

            </div>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>