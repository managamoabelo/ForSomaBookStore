@model IEnumerable<ForSomaBookStore.Models.Transaction>

<h2>Transactions</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Textbook</th>
            <th>Offer Amount</th>
            <th>Status</th>
            <th>Date</th>
            <th>Meetup Location</th>
            <th>Actions</th>
            <th>Review</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Offer?.Textbook?.Title</td>

                <td>
                    R @item.Offer?.OfferAmount.ToString("N2")
                </td>

                <td>
                    @if (item.Status == Transaction.TransactionStatus.Completed)
                    {
                        <span class="badge bg-success">Completed</span>
                    }
                    else if (item.Status == Transaction.TransactionStatus.Cancelled)
                    {
                        <span class="badge bg-danger">Cancelled</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                </td>

                <td>@item.TransactionDate.ToShortDateString()</td>

                <td>@item.MeetupLocation</td>

                <td>

                    @if (!item.Paid)
                    {
                        <a asp-action="Pay"
                           asp-route-id="@item.Id"
                           class="btn btn-primary btn-sm">
                            Pay
                        </a>
                    }
                    else if (!item.Completed)
                    {
                        <a asp-action="Complete"
                           asp-route-id="@item.Id"
                           class="btn btn-success btn-sm">
                            Complete
                        </a>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            Completed
                        </span>
                    }

                </td>

                <td>
                    @if (item.Completed)
                    {
                        <a asp-controller="Reviews"
                           asp-action="LeaveReview"
                           asp-route-transactionId="@item.Id"
                           asp-route-revieweeId="@item.Offer?.Textbook?.UserId"
                           class="btn btn-primary btn-sm">
                            Leave Review
                        </a>
                    }
                </td>

            </tr>
        }
    </tbody>
</table>