@model IEnumerable<ForSomaBookStore.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
}

<h2>Notifications</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You have no notifications at the moment.
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Message</th>
                <th>Date</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Message</td>

                    <td>
                        @item.CreatedAt.ToString("dd MMM yyyy HH:mm")
                    </td>

                    <td>
                        @(item.IsRead ? "Read" : "Unread")
                    </td>

                    <td>
                        @if (!item.IsRead)
                        {
                            <a asp-action="MarkAsRead"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-primary">
                                Mark Read
                            </a>
                        }
                    </td>
                </tr>
            }

        </tbody>
    </table>
}